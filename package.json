{
  "name": "big-sox-studios",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "astro dev",
    "build": "astro check && astro build",
    "preview": "astro preview",
    "check": "astro check",
    "lint": "eslint .",
    "validate": "npm run lint && npm run build",
    "test:membership": "node --test --experimental-test-isolation=none tests/membership-*.test.mjs",
    "test:public": "node --test --experimental-test-isolation=none tests/public-sign-in.test.mjs",
    "test:notify": "node --test --experimental-test-isolation=none membership-notify/test/*.test.mjs"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.0",
    "astro": "^7.0.0",
    "typescript": "^5.9.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "eslint": "10.13.0",
    "eslint-plugin-astro": "2.1.1",
    "globals": "^16.0.0",
    "wrangler": "^4.36.0"
  },
  "engines": {
    "node": "24.22.x",
    "npm": ">=10.9.4 <11"
  },
  "packageManager": "npm@10.9.4"
}
