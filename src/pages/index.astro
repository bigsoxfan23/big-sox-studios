---
import BaseLayout from '../layouts/BaseLayout.astro';
const gateways=[
 {title:'Projects',href:'/projects',kicker:'Builds & experiments',copy:'Things I’m making, testing, learning, and occasionally turning into something useful.',tone:'projects',scene:'workbench'},
 {title:'AI Agents',href:'/ai-agents',kicker:'Meet the team',copy:'A peek inside the small crew of AI agents helping ideas move from curious to working.',tone:'agents',scene:'control'},
 {title:'Austin Favorites',href:'/austin-favorites',kicker:'Curated by Greg & Sarah',copy:'The places, meals, and local finds we’d actually tell a friend to try.',tone:'austin',scene:'austin'},
 {title:'About',href:'/about',kicker:'Behind the studio',copy:'A little about me, the interests behind the work, and why this place exists.',tone:'about',scene:'scrapbook'}
];
---
<BaseLayout>
<section class="hero container" aria-labelledby="home-title"><div class="hero-copy"><p class="eyebrow">Independent digital workshop</p><h1 id="home-title"><span>BIG SOX</span><span>STUDIOS</span></h1><p class="statement">A small studio for big ideas.</p><p class="lede">Projects, experiments, and useful ideas across AI, travel, tech, and everyday life.</p><a class="text-link" href="#explore">See what’s inside <span aria-hidden="true">↓</span></a></div><div class="hero-mark" aria-hidden="true"><div class="orbit orbit-one"></div><div class="orbit orbit-two"></div><div class="mascot"><span class="eye left"></span><span class="eye right"></span><span class="arm"></span></div><p>BIG IDEAS<br/><em>WELCOME</em></p></div></section>
<section id="explore" class="gateway-section container" aria-labelledby="explore-title"><div class="section-heading"><div><p class="eyebrow">Four doors, one studio</p><h2 id="explore-title">Explore Big Sox</h2></div><p>Pick a direction. Everything here starts with curiosity and gets built in public when it’s ready.</p></div><div class="gateway-grid">{gateways.map((card,index)=><a class:list={['gateway-card',card.tone]} href={card.href}><div class:list={['card-art',card.scene]} aria-hidden="true">{card.scene==='workbench'&&<><span class="window"></span><span class="desk"></span><span class="lamp"></span></>}{card.scene==='control'&&<><span class="console"></span><span class="agent agent-a"></span><span class="agent agent-b"></span><span class="signal"></span></>}{card.scene==='austin'&&<><span class="sun"></span><span class="skyline"></span><span class="road"></span></>}{card.scene==='scrapbook'&&<><span class="note">MAKE<br/>STUFF</span><span class="tape"></span><span class="sock">B</span></>}<span class="card-number">0{index+1}</span></div><div class="card-copy"><p>{card.kicker}</p><h3>{card.title}</h3><span>{card.copy}</span><strong>Enter <i aria-hidden="true">↗</i></strong></div></a>)}</div></section>
<section class="newsletter-band"><div class="container newsletter-inner"><div><p class="eyebrow">Studio notes</p><h2>Worth sending.<br/>Not just sending.</h2></div><div class="newsletter-copy"><p>An occasional dispatch when there’s a project, find, experiment, or idea worth sharing. No content treadmill.</p><a class="button" href="/newsletter">Join the newsletter <span aria-hidden="true">→</span></a></div></div></section>
</BaseLayout>
<style>
.hero{display:grid;grid-template-columns:minmax(0,1.45fr) minmax(18rem,.55fr);gap:clamp(2rem,7vw,7rem);align-items:center;min-height:calc(100svh - 9rem);padding-block:clamp(3rem,8vw,7rem)}.hero h1{margin:.65rem 0 1.5rem;font-family:var(--font-body);font-size:clamp(4rem,11vw,9.5rem);font-weight:950;line-height:.76;letter-spacing:-.075em}.hero h1 span{display:block}.hero h1 span:last-child{color:var(--accent)}.statement{margin:0;font-family:var(--font-display);font-size:clamp(1.8rem,4vw,3.25rem);line-height:1.05}.hero .lede{margin:1.2rem 0 1.5rem;max-width:40rem}.text-link{display:inline-flex;gap:.6rem;align-items:center;font-weight:800;text-underline-offset:.3rem}.hero-mark{position:relative;aspect-ratio:1;display:grid;place-items:center;border:1px solid var(--border);border-radius:50%;background:radial-gradient(circle at 50% 42%,var(--surface-strong),var(--surface));overflow:hidden}.hero-mark>p{position:absolute;bottom:10%;right:10%;margin:0;font-size:.7rem;font-weight:900;letter-spacing:.12em;text-align:right}.hero-mark em{color:var(--accent);font-style:normal}.orbit{position:absolute;border:1px solid var(--border);border-radius:50%}.orbit-one{width:76%;height:76%}.orbit-two{width:110%;height:35%;transform:rotate(-24deg)}.mascot{position:relative;width:38%;height:44%;background:var(--surface-strong);border:1px solid var(--border);border-radius:48% 52% 43% 46%;box-shadow:var(--shadow-soft);transform:rotate(3deg)}.eye{position:absolute;top:39%;width:7%;aspect-ratio:1;border-radius:50%;background:var(--text)}.eye.left{left:32%}.eye.right{right:32%}.arm{position:absolute;right:-30%;top:43%;width:40%;height:12%;border-radius:999px;background:var(--surface-strong);border:1px solid var(--border);transform-origin:left center;transform:rotate(-38deg)}
.gateway-section{padding-block:clamp(4rem,9vw,8rem);border-top:1px solid var(--border)}.section-heading{display:grid;grid-template-columns:1fr minmax(16rem,28rem);gap:2rem;align-items:end;margin-bottom:2rem}.section-heading h2,.newsletter-inner h2{margin:.3rem 0 0;font-size:clamp(2.7rem,6vw,5.5rem);letter-spacing:-.045em}.section-heading>p{margin:0;color:var(--muted);line-height:1.6}.gateway-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:1rem}.gateway-card{display:grid;grid-template-rows:auto 1fr;min-height:34rem;border:1px solid var(--border);border-radius:var(--radius-lg);overflow:hidden;background:var(--surface);text-decoration:none;box-shadow:0 1px 0 rgba(0,0,0,.02);transition:transform .25s ease,box-shadow .25s ease}.gateway-card:hover{transform:translateY(-5px);box-shadow:var(--shadow-soft)}.card-art{position:relative;min-height:18rem;overflow:hidden;border-bottom:1px solid var(--border)}.projects .card-art{background:linear-gradient(135deg,#d8a37f,#f2d8bb)}.agents .card-art{background:linear-gradient(135deg,#8e9cad,#cad4dc)}.austin .card-art{background:linear-gradient(135deg,#9bad8f,#e0c996)}.about .card-art{background:linear-gradient(135deg,#b899b3,#e8cfc5)}.card-number{position:absolute;top:1rem;right:1rem;font-weight:900;font-size:.72rem;letter-spacing:.1em;color:rgba(23,32,43,.65)}.card-copy{padding:1.5rem;display:flex;flex-direction:column}.card-copy p{margin:0 0 .5rem;color:var(--muted);font-size:.72rem;font-weight:800;letter-spacing:.08em;text-transform:uppercase}.card-copy h3{margin:0 0 .75rem;font-size:clamp(2.1rem,4vw,3.5rem);letter-spacing:-.035em}.card-copy>span{max-width:32rem;color:var(--muted);line-height:1.55}.card-copy strong{display:flex;justify-content:space-between;margin-top:auto;padding-top:2rem;font-size:.85rem}.card-copy i{font-style:normal;font-size:1.2rem}
.window{position:absolute;left:10%;top:12%;width:48%;height:45%;border:8px solid rgba(255,255,255,.65);background:linear-gradient(#91a4ac 55%,#c2a06d 56%)}.desk{position:absolute;left:8%;right:7%;bottom:17%;height:9%;background:#654b3e;border-radius:3px}.lamp{position:absolute;right:18%;bottom:26%;width:4%;height:32%;background:#403d3c}.lamp:before{content:'';position:absolute;right:-100%;top:-4%;width:280%;height:22%;background:#403d3c;border-radius:50% 50% 10% 10%}.console{position:absolute;left:12%;right:12%;bottom:13%;height:30%;background:#35414d;transform:perspective(12rem) rotateX(18deg);border-radius:.5rem}.console:before{content:'';position:absolute;inset:18% 10%;background:repeating-linear-gradient(90deg,#e9a849 0 5%,transparent 5% 12%);opacity:.8}.agent{position:absolute;bottom:34%;width:16%;height:28%;background:#f8f5ec;border:1px solid rgba(23,32,43,.2);border-radius:50% 50% 42% 45%}.agent:after{content:'';position:absolute;left:28%;top:38%;width:8%;aspect-ratio:1;border-radius:50%;background:#26313c;box-shadow:1.8rem 0 #26313c}.agent-a{left:27%}.agent-b{right:27%;transform:scale(.9)}.signal{position:absolute;top:13%;left:16%;width:68%;height:5%;background:repeating-linear-gradient(90deg,rgba(255,255,255,.55) 0 8%,transparent 8% 13%)}.sun{position:absolute;width:26%;aspect-ratio:1;border-radius:50%;background:#e7a34b;right:13%;top:13%}.skyline{position:absolute;left:8%;right:8%;bottom:26%;height:35%;background:linear-gradient(90deg,#48564d 0 12%,transparent 12% 15%,#48564d 15% 25%,transparent 25% 29%,#48564d 29% 48%,transparent 48% 51%,#48564d 51% 62%,transparent 62% 66%,#48564d 66%);clip-path:polygon(0 55%,12% 55%,12% 30%,25% 30%,25% 60%,40% 60%,40% 10%,54% 10%,54% 48%,70% 48%,70% 28%,82% 28%,82% 58%,100% 58%,100% 100%,0 100%)}.road{position:absolute;bottom:-15%;left:25%;width:50%;height:55%;background:#b5a486;clip-path:polygon(42% 0,58% 0,100% 100%,0 100%)}.note{position:absolute;left:16%;top:20%;padding:1.2rem 1.4rem;background:#f8efb9;color:#2e2b31;font-family:var(--font-display);font-size:1.5rem;line-height:.9;transform:rotate(-5deg);box-shadow:0 8px 20px rgba(0,0,0,.1)}.tape{position:absolute;left:28%;top:15%;width:13%;height:7%;background:rgba(255,255,255,.55);transform:rotate(8deg)}.sock{position:absolute;right:18%;bottom:18%;width:26%;height:48%;display:grid;place-items:center;background:#f8f5ec;color:#d97706;font-weight:950;font-size:2rem;border-radius:45% 45% 50% 20%;transform:rotate(8deg);box-shadow:var(--shadow-soft)}.sock:after{content:'';position:absolute;left:-38%;bottom:0;width:58%;height:28%;background:#f8f5ec;border-radius:60% 0 0 60%}
.newsletter-band{margin-top:clamp(2rem,5vw,5rem);padding-block:clamp(4rem,9vw,8rem);background:var(--text);color:var(--bg)}.newsletter-inner{display:grid;grid-template-columns:1.2fr .8fr;gap:clamp(2rem,8vw,8rem);align-items:end}.newsletter-band .eyebrow{color:#f2a33b}.newsletter-copy p{margin:0 0 1.5rem;color:color-mix(in srgb,var(--bg) 72%,transparent);font-size:1.1rem;line-height:1.65}.button{display:inline-flex;align-items:center;gap:1.2rem;padding:.9rem 1.15rem;border-radius:999px;background:var(--bg);color:var(--text);font-weight:800;text-decoration:none}
@media(max-width:55rem){.hero{grid-template-columns:1fr;gap:2.4rem;min-height:auto;padding-block:clamp(2.5rem,8vw,4.5rem)}.hero-copy{max-width:42rem}.hero h1{font-size:clamp(4rem,16vw,7rem);line-height:.82;margin:.55rem 0 1.25rem}.hero .lede{margin:1rem 0 1.25rem}.hero-mark{width:min(64vw,21rem);justify-self:center}.gateway-section{padding-block:clamp(3.5rem,9vw,5.5rem)}.section-heading,.newsletter-inner{grid-template-columns:1fr}.section-heading{gap:1rem;margin-bottom:1.5rem}.gateway-grid{grid-template-columns:1fr;gap:1.15rem}.gateway-card{min-height:29rem;box-shadow:0 10px 30px rgba(23,32,43,.045)}.card-art{min-height:15rem}.card-copy{padding:1.35rem 1.4rem}.newsletter-band{margin-top:2rem;padding-block:clamp(3.5rem,9vw,5.5rem)}.newsletter-inner{gap:1.4rem}.newsletter-copy p{font-size:1rem}.button{width:100%;justify-content:space-between}}@media(max-width:36rem){.hero{gap:2rem;padding-top:2.25rem}.hero h1{font-size:clamp(3.25rem,16.5vw,4.65rem);line-height:.84;letter-spacing:-.065em}.statement{font-size:clamp(1.7rem,8vw,2.2rem)}.hero-mark{width:min(62vw,18rem)}.hero-mark>p{font-size:.6rem}.gateway-card{min-height:27rem}.card-art{min-height:13.5rem}.card-copy h3{font-size:2.35rem}.newsletter-inner h2{font-size:clamp(2.65rem,13vw,4rem)}}
</style>
