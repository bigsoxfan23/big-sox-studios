---
import BaseLayout from '../layouts/BaseLayout.astro';
const benefits=[
  {number:'01',icon:'▣',title:'Your media corner',description:'A convenient way to find and launch Jellyfin when your account has been approved. Jellyfin will still use its own library permissions.',note:'Jellyfin · Planned'},
  {number:'02',icon:'◇',title:'Game-night connections',description:'See when an approved game server is available and find the connection details you need, without digging through messages.',note:'Palworld · Planned'},
  {number:'03',icon:'◷',title:'A clear service check',description:'See simple online, offline, or paused indicators for the services shared with you—without exposing private server controls.',note:'Status · Planned'}
];
const steps=[
  {n:'1',title:'Get invited',body:'Ask Greg directly to be considered. Access is personal, limited, and approved individually—not open registration.'},
  {n:'2',title:'Verify it\'s you',body:'Once the portal launches, sign in with Google, Apple, or an email login code, then complete the required extra security check.'},
  {n:'3',title:'Open your services',body:'Your dashboard shows only the services approved for your account. Some services, including Jellyfin, may require a separate service login.'}
];
---
<BaseLayout title="Members" description="A preview of the invitation-only Big Sox Studios members area for family, friends and approved members.">
  <section class="members-hero container" aria-labelledby="members-title">
    <div class="hero-copy">
      <p class="eyebrow">BIG SOX STUDIOS / MEMBERS</p>
      <p class="status"><span aria-hidden="true"></span> In development · Invite only</p>
      <h1 id="members-title">Good company.<br/><span>A little more access.</span></h1>
      <p class="lead">A private home for friends, family, and invited members of the studio. One spot for shared media, game servers, and simple updates on what's available.</p>
      <div class="hero-actions">
        <a class="primary-button" href="#how-to-join">How to get access <span aria-hidden="true">↗</span></a>
        <a class="quiet-link" href="#whats-inside">Explore member perks <span aria-hidden="true">↓</span></a>
      </div>
    </div>
    <div class="portal-illustration" aria-hidden="true">
      <div class="illus-top"><span class="mini-mark">BSS <strong>●</strong></span><span class="mini-badge">MEMBERS</span></div>
      <div class="illus-greeting"><span>YOUR STUDIO CORNER</span><strong>Welcome in.</strong></div>
      <div class="illus-grid"><div class="illus-tile"><span>▣</span><strong>Media</strong><small>COMING SOON</small></div><div class="illus-tile"><span>◇</span><strong>Games</strong><small>COMING SOON</small></div><div class="illus-tile wide"><span>◉</span><strong>Service status</strong><small>COMING SOON</small></div></div>
      <div class="illus-bottom">THE GOOD STUFF, BEHIND THE DOOR <span>↗</span></div>
    </div>
  </section>

  <section id="whats-inside" class="member-section container" aria-labelledby="inside-title">
    <div class="section-heading">
      <div><p class="eyebrow">WHAT'S INSIDE</p><h2 id="inside-title">Your little corner<br/>of Big Sox Studios.</h2></div>
      <p>The members area will bring together a few handy things for people we know. You'll only see the services Greg has chosen to share with you.</p>
    </div>
    <div class="benefits">
      {benefits.map((b)=><article class="benefit"><div class="benefit-top"><span class="benefit-icon" aria-hidden="true">{b.icon}</span><span class="number">{b.number}</span></div><h3>{b.title}</h3><p>{b.description}</p><div class="benefit-note">{b.note}</div></article>)}
    </div>
    <p class="fine-print">Features are planned, not live. Service availability may change, and an invitation doesn't guarantee access to every service.</p>
  </section>

  <section class="how-band" aria-labelledby="how-title">
    <div class="container">
      <div class="section-heading"><div><p class="eyebrow">HOW IT WORKS</p><h2 id="how-title">A friendly hello.<br/>A secure front door.</h2></div><p>No public signup, no shared group password, and no surprise access to private systems.</p></div>
      <div class="steps">{steps.map(step=><div class="step"><div class="step-number">{step.n}</div><h3>{step.title}</h3><p>{step.body}</p></div>)}</div>
    </div>
  </section>

  <section id="how-to-join" class="join container" aria-labelledby="join-title">
    <div class="join-card">
      <div><p class="eyebrow">REQUESTING ACCESS</p><h2 id="join-title">Know someone at the studio?</h2><p>Members are invited personally by Greg. If we're already in touch, ask Greg directly about getting an invitation when the portal opens. There isn't an online application or public signup right now.</p><p class="join-note"><strong>Not accepting logins yet.</strong> Google, Apple, email codes, and mandatory multi-factor verification are being built and tested. We'll open member access after the security checks pass.</p></div>
      <div class="join-stamp" aria-hidden="true"><span>INVITE</span><strong>ONLY</strong><small>SOCKS OPTIONAL</small></div>
    </div>
    <div class="bottom-links"><a href="/">← Back to the studio</a><span>Big Sox Studios · A small studio for big ideas.</span></div>
  </section>
</BaseLayout>
<style>
.members-hero{display:grid;grid-template-columns:minmax(0,1.12fr) minmax(19rem,.88fr);gap:clamp(2rem,5vw,5rem);align-items:center;padding-block:clamp(1rem,4vw,4rem) clamp(5rem,9vw,8rem)}
.status{display:inline-flex;align-items:center;gap:.6rem;width:max-content;padding:.48rem .85rem;margin:.45rem 0 1.5rem;border:1px solid var(--border);border-radius:999px;background:var(--surface);font-size:.76rem;font-weight:800;letter-spacing:.01em}
.status span{width:.5rem;height:.5rem;border-radius:50%;background:var(--accent)}
h1{font-family:var(--font-body);font-size:clamp(3.1rem,7vw,6.8rem);font-weight:950;line-height:.95;letter-spacing:-.07em;margin:0 0 1.5rem}h1 span{color:var(--accent)}
.lead{max-width:38rem;color:var(--muted);font-size:clamp(1.05rem,1.5vw,1.2rem);line-height:1.7}.hero-actions{display:flex;align-items:center;gap:1.4rem;flex-wrap:wrap;margin-top:2rem}
.primary-button{display:inline-flex;align-items:center;justify-content:space-between;gap:1.4rem;padding:1rem 1.35rem;border-radius:999px;background:var(--text);color:var(--bg);font-weight:850;text-decoration:none;transition:transform .2s ease}.primary-button:hover{transform:translateY(-2px)}.quiet-link{font-weight:800;text-underline-offset:.3rem}
.portal-illustration{transform:rotate(2deg);padding:1.2rem;border:1px solid var(--border);border-radius:1.8rem;background:var(--surface-strong);box-shadow:0 23px 65px rgba(23,32,43,.12)}.illus-top,.illus-bottom{display:flex;justify-content:space-between;align-items:center;gap:1rem}.mini-mark{font-weight:1000;letter-spacing:-.06em;font-size:1.3rem}.mini-mark strong{color:var(--accent)}.mini-badge{padding:.4rem .7rem;border-radius:99px;background:var(--accent-soft);color:#35291b;font-size:.67rem;letter-spacing:.13em;font-weight:900}.illus-greeting{padding:2.3rem .45rem 1.5rem}.illus-greeting>span{display:block;font-size:.65rem;letter-spacing:.16em;font-weight:900;color:var(--muted)}.illus-greeting>strong{display:block;font-family:var(--font-display);font-size:clamp(2.2rem,4vw,3.7rem);letter-spacing:-.05em;margin-top:.4rem}.illus-grid{display:grid;grid-template-columns:1fr 1fr;gap:.65rem}.illus-tile{display:flex;flex-direction:column;gap:.4rem;min-height:7rem;padding:1rem;border-radius:1rem;background:var(--bg);border:1px solid var(--border)}.illus-tile>span{font-size:1.6rem;color:var(--accent)}.illus-tile>strong{font-size:1.05rem}.illus-tile small{color:var(--muted);font-size:.58rem;font-weight:900;letter-spacing:.1em}.illus-tile.wide{grid-column:1/-1;min-height:5.8rem}.illus-bottom{font-size:.58rem;font-weight:850;letter-spacing:.13em;color:var(--muted);padding:.9rem .35rem .05rem}
.member-section{padding-block:clamp(4rem,8vw,7rem);border-top:1px solid var(--border)}.section-heading{display:grid;grid-template-columns:minmax(0,1fr) minmax(15rem,26rem);gap:2rem;align-items:end;margin-bottom:2rem}.section-heading h2,.join h2{font-size:clamp(2.6rem,5.2vw,5.2rem);line-height:1;letter-spacing:-.045em;margin:.45rem 0 0}.section-heading>p{color:var(--muted);line-height:1.65;margin:0}
.benefits{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:1rem}.benefit{display:flex;flex-direction:column;padding:clamp(1.4rem,2.5vw,2.2rem);min-height:21rem;background:var(--surface);border-radius:var(--radius-lg);border:1px solid var(--border)}.benefit-top{display:flex;justify-content:space-between;align-items:flex-start}.benefit-icon{display:grid;place-items:center;width:3rem;height:3rem;border-radius:.85rem;background:var(--accent-soft);color:#35291b;font-size:1.6rem}.number{color:var(--muted);font-size:.7rem;font-weight:900;letter-spacing:.12em}.benefit h3{font-size:clamp(1.65rem,2.8vw,2.4rem);margin:2.5rem 0 .7rem;line-height:1.05}.benefit p{margin:0;color:var(--muted);line-height:1.6}.benefit-note{margin-top:auto;padding-top:1.8rem;font-size:.71rem;font-weight:900;letter-spacing:.05em;text-transform:uppercase;color:var(--accent)}.fine-print{color:var(--muted);font-size:.85rem;margin:1.3rem 0 0}
.how-band{padding-block:clamp(4rem,8vw,7rem);background:var(--text);color:var(--bg)}.how-band .eyebrow{color:#f2a33b}.how-band .section-heading>p{color:color-mix(in srgb,var(--bg) 76%,transparent)}.steps{display:grid;grid-template-columns:repeat(3,1fr);gap:clamp(1.5rem,4vw,4rem);margin-top:3rem}.step{border-top:1px solid color-mix(in srgb,var(--bg) 33%,transparent);padding-top:1.5rem}.step-number{display:grid;place-items:center;width:3rem;height:3rem;border:1px solid color-mix(in srgb,var(--bg) 55%,transparent);border-radius:50%;font-weight:900}.step h3{font-size:clamp(1.6rem,2.6vw,2.3rem);margin:1.65rem 0 .75rem}.step p{color:color-mix(in srgb,var(--bg) 76%,transparent);line-height:1.65}
.join{padding-block:clamp(4rem,8vw,8rem)}.join-card{display:grid;grid-template-columns:minmax(0,1fr) auto;align-items:center;gap:3rem;padding:clamp(1.4rem,5vw,4rem);border-radius:var(--radius-lg);border:1px solid var(--border);background:var(--surface)}.join h2{margin:.45rem 0 1.2rem}.join p:not(.eyebrow){max-width:43rem;color:var(--muted);line-height:1.7}.join .join-note{margin-top:1.2rem;color:var(--text)!important}.join-stamp{display:flex;flex-direction:column;align-items:center;justify-content:center;width:clamp(11rem,18vw,15rem);aspect-ratio:1;border:4px double var(--accent);border-radius:50%;transform:rotate(-11deg);color:var(--accent)}.join-stamp span{font-size:.8rem;font-weight:900;letter-spacing:.16em}.join-stamp strong{font-size:clamp(2.5rem,4.5vw,4rem);letter-spacing:-.07em}.join-stamp small{font-size:.56rem;letter-spacing:.09em;font-weight:900}.bottom-links{display:flex;justify-content:space-between;gap:1rem;flex-wrap:wrap;padding:2rem 0 0;font-size:.85rem;color:var(--muted)}.bottom-links a{font-weight:800;color:var(--text)}
@media(max-width:65rem){.members-hero{grid-template-columns:1fr}.portal-illustration{max-width:33rem;width:100%;justify-self:center;transform:none}}
@media(max-width:50rem){.section-heading{grid-template-columns:1fr;gap:1rem}.benefits,.steps{grid-template-columns:1fr}.benefit{min-height:0}.benefit h3{margin-top:1.5rem}.join-card{grid-template-columns:1fr}.join-stamp{justify-self:center}.members-hero{padding-bottom:4rem}.hero-actions{align-items:stretch;gap:1rem}.primary-button{width:100%}.steps{margin-top:2rem}}
@media(max-width:30rem){h1{font-size:clamp(2.8rem,13vw,4rem)}.portal-illustration{padding:.85rem}.join-stamp{width:10rem}}
</style>
