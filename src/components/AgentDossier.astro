---
const { employee, agent, index = 0 } = Astro.props;
const statusClass = employee.status.toLowerCase().replace(/[^a-z]+/g, '-');
const reverse = index % 2 === 1;
---
<section class:list={['agent-dossier', statusClass, { reverse }]} aria-labelledby={`dossier-${employee.id}`}>
  <div class="dossier-visual">
    <div class="dossier-frame">
      <div class="frame-top">
        <span>OPS-{String(index + 1).padStart(2, '0')}</span>
        <span class:list={['status-chip', statusClass]}>{employee.status}</span>
      </div>
      <img src={employee.photo} alt={`${employee.name}, ${employee.title}`} width="480" height="480" loading="lazy" decoding="async" />
    </div>
  </div>

  <div class="dossier-copy">
    <p class="role-label">{employee.status === 'PRE-HIRE' ? `${employee.title} · Future agent` : employee.title}</p>
    <h2 id={`dossier-${employee.id}`}>{employee.name}</h2>
    <p class="hook">{agent.hook}</p>

    <ul class="capabilities" aria-label={`${employee.name} capabilities`}>
      {agent.capabilities[0] && <li>{agent.capabilities[0]}</li>}
      {agent.capabilities[1] && <li>{agent.capabilities[1]}</li>}
      {agent.capabilities[2] && <li>{agent.capabilities[2]}</li>}
      {agent.capabilities[3] && <li>{agent.capabilities[3]}</li>}
    </ul>

    <section class="what-they-do">
      <p class="detail-label">What they do</p>
      <p>{agent.job}</p>
    </section>

    <div class="detail-grid">
      <section>
        <p class="detail-label">Why this role exists</p>
        <p>{agent.why}</p>
      </section>

      <section>
        <p class="detail-label">Current status</p>
        <p>{agent.current}</p>
      </section>
    </div>

    <section class="jobs">
      <p class="detail-label">Example jobs</p>
      <ul>
        {agent.examples[0] && <li>{agent.examples[0]}</li>}
        {agent.examples[1] && <li>{agent.examples[1]}</li>}
        {agent.examples[2] && <li>{agent.examples[2]}</li>}
        {agent.examples[3] && <li>{agent.examples[3]}</li>}
        {agent.examples[4] && <li>{agent.examples[4]}</li>}
        {agent.examples[5] && <li>{agent.examples[5]}</li>}
      </ul>
    </section>

    <section class="boundary">
      <p class="detail-label">Operational boundaries</p>
      <p>{agent.boundaries}</p>
    </section>

    <blockquote>{agent.personality}</blockquote>
  </div>
</section>

<style>
.agent-dossier{display:grid;grid-template-columns:minmax(18rem,.82fr) minmax(0,1.18fr);gap:clamp(2rem,6vw,5rem);align-items:start;padding-block:clamp(3.8rem,7vw,6.5rem);border-top:1px solid var(--border)}
.agent-dossier:first-child{padding-top:1rem;border-top:0}
.agent-dossier.reverse{grid-template-columns:minmax(0,1.18fr) minmax(18rem,.82fr)}
.agent-dossier.reverse .dossier-visual{order:2}
.agent-dossier.reverse .dossier-copy{order:1}
.dossier-visual{min-width:0;position:sticky;top:6.5rem}
.dossier-frame{position:relative;overflow:hidden;border:1px solid var(--border);border-radius:1.35rem;background:linear-gradient(155deg,color-mix(in srgb,var(--agents) 13%,var(--surface-strong)),var(--surface-strong));box-shadow:var(--shadow-soft)}
.dossier-frame:before{content:'';position:absolute;inset:0;background-image:linear-gradient(color-mix(in srgb,var(--agents) 10%,transparent) 1px,transparent 1px),linear-gradient(90deg,color-mix(in srgb,var(--agents) 10%,transparent) 1px,transparent 1px);background-size:24px 24px;pointer-events:none}
.frame-top{position:relative;z-index:1;display:flex;align-items:center;justify-content:space-between;gap:1rem;padding:.8rem .9rem;border-bottom:1px solid var(--border);background:color-mix(in srgb,var(--surface) 82%,transparent);color:var(--muted);font-size:.62rem;font-weight:900;letter-spacing:.12em}
.status-chip{display:inline-flex;align-items:center;gap:.38rem;padding:.34rem .5rem;border:1px solid var(--border);border-radius:999px;font-size:.58rem;font-weight:950;letter-spacing:.08em}
.status-chip:before{content:'';width:.46rem;aspect-ratio:1;border-radius:50%;background:currentColor}
.status-chip.active{color:#447454}
.status-chip.onboarding{color:#b26b08}
.status-chip.pre-hire{color:#806278;border-style:dashed}
.dossier-frame img{position:relative;z-index:1;display:block;width:100%;height:auto;aspect-ratio:1;object-fit:cover;object-position:center;background:var(--surface)}
.dossier-copy{min-width:0;padding-top:.2rem}
.role-label{margin:0;color:var(--agents);font-size:.7rem;font-weight:900;letter-spacing:.1em;text-transform:uppercase}
.dossier-copy h2{margin:.22rem 0 .75rem;font-size:clamp(3.5rem,8vw,7.5rem);letter-spacing:-.065em}
.hook{max-width:48rem;margin:0;color:var(--muted);font-family:var(--font-display);font-size:clamp(1.25rem,2.3vw,1.8rem);line-height:1.3}
.capabilities{display:flex;flex-wrap:wrap;gap:.45rem;margin:1rem 0 0;padding:0;list-style:none}
.capabilities li{padding:.4rem .55rem;border:1px solid var(--border);border-radius:.6rem;background:var(--surface);font-size:.7rem;font-weight:750}
.what-they-do{margin-top:1.5rem;padding:1rem 1.05rem;border:1px solid var(--border);border-radius:1rem;background:linear-gradient(145deg,color-mix(in srgb,var(--agents) 7%,var(--surface)),var(--surface))}
.what-they-do p:last-child{margin:0;color:var(--text);font-size:1rem;line-height:1.65}
.detail-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:1rem;margin-top:1rem}
.detail-grid section,.jobs,.boundary{padding:1rem;border:1px solid var(--border);border-radius:1rem;background:var(--surface)}
.detail-label{margin:0 0 .45rem;color:var(--agents);font-size:.66rem;font-weight:900;letter-spacing:.1em;text-transform:uppercase}
.detail-grid p:last-child,.boundary p:last-child{margin:0;color:var(--muted);font-size:.9rem;line-height:1.6}
.jobs{margin-top:1rem}
.jobs ul{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:.55rem .85rem;margin:.75rem 0 0;padding:0;list-style:none}
.jobs li{position:relative;padding-left:1rem;color:var(--muted);font-size:.87rem;line-height:1.45}
.jobs li:before{content:'→';position:absolute;left:0;color:var(--accent);font-weight:900}
.boundary{margin-top:1rem}
blockquote{margin:1rem 0 0;padding:1rem 1.1rem;border-left:3px solid var(--accent);border-radius:0 .9rem .9rem 0;background:color-mix(in srgb,var(--accent) 7%,var(--surface));font-family:var(--font-display);font-size:1.05rem;font-style:italic;line-height:1.45}
.agent-dossier.pre-hire .dossier-frame{border-style:dashed;background:linear-gradient(155deg,color-mix(in srgb,var(--about) 12%,var(--surface-strong)),var(--surface-strong))}
.agent-dossier.pre-hire .dossier-frame img{filter:saturate(.88)}
@media(max-width:56rem){.agent-dossier,.agent-dossier.reverse{grid-template-columns:1fr;gap:1.6rem}.agent-dossier.reverse .dossier-visual,.agent-dossier.reverse .dossier-copy{order:initial}.dossier-visual{position:static}.dossier-frame{width:min(100%,34rem);margin-inline:auto}}
@media(max-width:42rem){.detail-grid,.jobs ul{grid-template-columns:1fr}.agent-dossier{padding-block:3.2rem}.agent-dossier:first-child{padding-top:.5rem}.dossier-copy h2{font-size:clamp(3.4rem,18vw,5.6rem)}.hook{font-size:1.18rem}.what-they-do{margin-top:1.25rem}}
</style>
