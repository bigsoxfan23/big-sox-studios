---
const { employee, agent, index = 0 } = Astro.props;
const statusClass = employee.status.toLowerCase().replace(/[^a-z]+/g, '-');
---
<article class:list={['agent-overview', statusClass]} aria-labelledby={`agent-overview-${employee.id}`}>
  <div class="overview-topline">
    <span class="unit">OPS-{String(index + 1).padStart(2, '0')}</span>
    <span class:list={['status-chip', statusClass]}>{employee.status}</span>
  </div>

  <div class="portrait-wrap">
    <div class="signal" aria-hidden="true"><span></span><span></span><span></span></div>
    <img src={employee.photo} alt={`${employee.name}, ${employee.title}`} width="480" height="480" loading="lazy" decoding="async" />
  </div>

  <div class="overview-copy">
    <p class="role-label">{employee.title}</p>
    <h2 id={`agent-overview-${employee.id}`}>{employee.name}</h2>
    <p class="hook">{agent.hook}</p>
    <ul class="capabilities" aria-label={`${employee.name} capabilities`}>
      {agent.capabilities[0] && <li>{agent.capabilities[0]}</li>}
      {agent.capabilities[1] && <li>{agent.capabilities[1]}</li>}
      {agent.capabilities[2] && <li>{agent.capabilities[2]}</li>}
      {agent.capabilities[3] && <li>{agent.capabilities[3]}</li>}
    </ul>
  </div>
</article>

<style>
.agent-overview{position:relative;display:flex;min-width:0;flex-direction:column;overflow:hidden;border:1px solid var(--border);border-radius:1.35rem;background:linear-gradient(155deg,color-mix(in srgb,var(--agents) 10%,var(--surface-strong)),var(--surface-strong) 58%);box-shadow:var(--shadow-soft)}
.agent-overview:before{content:'';position:absolute;inset:0;pointer-events:none;background-image:linear-gradient(color-mix(in srgb,var(--agents) 11%,transparent) 1px,transparent 1px),linear-gradient(90deg,color-mix(in srgb,var(--agents) 11%,transparent) 1px,transparent 1px);background-size:22px 22px;mask-image:linear-gradient(to bottom,#000,transparent 52%);opacity:.45}
.overview-topline{position:relative;z-index:1;display:flex;align-items:center;justify-content:space-between;gap:1rem;padding:.9rem 1rem;border-bottom:1px solid var(--border);background:color-mix(in srgb,var(--surface) 78%,transparent)}
.unit{color:var(--muted);font-size:.62rem;font-weight:900;letter-spacing:.13em}
.status-chip{display:inline-flex;align-items:center;gap:.38rem;padding:.35rem .55rem;border:1px solid var(--border);border-radius:999px;font-size:.6rem;font-weight:950;letter-spacing:.08em}
.status-chip:before{content:'';width:.46rem;aspect-ratio:1;border-radius:50%;background:currentColor;box-shadow:0 0 0 .2rem color-mix(in srgb,currentColor 13%,transparent)}
.status-chip.active{color:#447454}
.status-chip.onboarding{color:#b26b08}
.status-chip.pre-hire{color:#806278;border-style:dashed}
.portrait-wrap{position:relative;z-index:1;display:grid;place-items:center;min-height:19rem;padding:1.4rem 1.4rem .5rem}
.portrait-wrap img{display:block;width:min(100%,18rem);height:auto;aspect-ratio:1;object-fit:cover;object-position:center;border-radius:1.2rem;border:1px solid color-mix(in srgb,var(--agents) 32%,var(--border));background:var(--surface);box-shadow:0 18px 42px rgba(23,32,43,.12)}
.signal{position:absolute;right:1rem;top:1rem;display:flex;gap:.28rem}
.signal span{width:.42rem;aspect-ratio:1;border-radius:50%;background:color-mix(in srgb,var(--agents) 55%,var(--surface));box-shadow:0 0 0 .2rem color-mix(in srgb,var(--agents) 8%,transparent)}
.signal span:first-child{background:var(--accent)}
.overview-copy{position:relative;z-index:1;padding:1.2rem 1.2rem 1.3rem}
.role-label{margin:0;color:var(--agents);font-size:.7rem;font-weight:900;letter-spacing:.1em;text-transform:uppercase}
.overview-copy h2{margin:.25rem 0 .7rem;font-size:clamp(2.4rem,5vw,4.5rem);letter-spacing:-.055em}
.hook{margin:0;color:var(--muted);font-size:.98rem;line-height:1.55}
.capabilities{display:flex;flex-wrap:wrap;gap:.4rem;margin:1rem 0 0;padding:0;list-style:none}
.capabilities li{padding:.38rem .5rem;border:1px solid var(--border);border-radius:.55rem;background:color-mix(in srgb,var(--surface) 78%,transparent);font-size:.67rem;font-weight:750}
.agent-overview.pre-hire{border-style:dashed;background:linear-gradient(155deg,color-mix(in srgb,var(--about) 10%,var(--surface-strong)),var(--surface-strong) 62%)}
.agent-overview.pre-hire .portrait-wrap img{filter:saturate(.88)}
@media(max-width:48rem){.portrait-wrap{min-height:auto;padding:1rem 1rem .35rem}.portrait-wrap img{width:min(78vw,18rem)}.overview-copy{padding:1rem}.hook{font-size:.94rem}}
</style>
