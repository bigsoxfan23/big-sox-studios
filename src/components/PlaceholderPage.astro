---
import BaseLayout from '../layouts/BaseLayout.astro';
const{title,eyebrow='Big Sox Studios',description,placeholder='This area will be designed and populated in a later implementation batch.',metaTitle=title,metaDescription=description}=Astro.props;
---
<BaseLayout title={metaTitle} description={metaDescription}><div class="container"><p class="eyebrow">{eyebrow}</p><h1>{title}</h1><p class="lede">{description}</p><section class="placeholder" aria-label="Foundation placeholder"><strong>Foundation route ready.</strong><p>{placeholder}</p></section></div></BaseLayout>
