---
import ThemeToggle from './ThemeToggle.astro';
const links=[['Projects','/projects'],['AI Agents','/ai-agents'],['Austin Favorites','/austin-favorites'],['About','/about'],['Newsletter','/newsletter']];
---
<header class="site-header">
  <div class="container nav-wrap">
    <a class="brand" href="/" aria-label="Big Sox Studios home"><picture><source media="(prefers-color-scheme: dark)" srcset="/brand/logo/big-sox-studios-logo-light.webp"/><img src="/brand/logo/big-sox-studios-logo-dark.webp" alt="Big Sox Studios" width="640" height="240"/></picture></a>
    <nav class="desktop-nav" aria-label="Primary navigation">
      {links.map(([label,href])=><a href={href}>{label}</a>)}
    </nav>
    <a class="member-cta" href="/members" aria-label="Members area — information and invitations">Members <span aria-hidden="true">↗</span></a>
    <details class="sign-in-menu" data-header-menu>
      <summary>Sign In <span class="chevron" aria-hidden="true">⌄</span></summary>
      <ul class="sign-in-options" aria-label="Sign In options">
        <li><span class="sign-in-disabled" aria-disabled="true">Member Sign In <small>Coming Soon</small></span></li>
        <li><a href="https://owner.bigsoxstudios.com/">Employee Sign In</a></li>
      </ul>
    </details>
    <ThemeToggle/>
    <details class="mobile-menu" data-header-menu>
      <summary aria-label="Navigation"><span></span><span></span></summary>
      <nav aria-label="Mobile navigation">
        {links.map(([label,href])=><a href={href}>{label}<i aria-hidden="true">↗</i></a>)}
        <div class="mobile-sign-in">
          <h2>Sign In</h2>
          <ul class="sign-in-options" aria-label="Sign In options">
            <li><span class="sign-in-disabled" aria-disabled="true">Member Sign In <small>Coming Soon</small></span></li>
            <li><a href="https://owner.bigsoxstudios.com/">Employee Sign In</a></li>
          </ul>
        </div>
      </nav>
    </details>
  </div>
</header>
<script>
  const menus = Array.from(document.querySelectorAll('[data-header-menu]'))
    .filter((menu) => menu instanceof HTMLDetailsElement);
  document.addEventListener('click', (event) => {
    for (const menu of menus) {
      if (menu.open && event.target instanceof Node && !menu.contains(event.target)) menu.open = false;
    }
  });
  document.addEventListener('keydown', (event) => {
    if (event.key !== 'Escape') return;
    for (const menu of menus) {
      if (menu.open) {
        const hadFocus = menu.contains(document.activeElement);
        menu.open = false;
        if (hadFocus) menu.querySelector('summary')?.focus();
        event.preventDefault();
      }
    }
  });
  for (const menu of menus) {
    menu.addEventListener('focusout', (event) => {
      if (event.relatedTarget instanceof Node && !menu.contains(event.relatedTarget)) menu.open = false;
    });
    menu.addEventListener('click', (event) => {
      if (event.target instanceof Element && event.target.closest('a')) menu.open = false;
    });
  }
  // A hidden open menu must not reappear when switching between layouts.
  matchMedia('(max-width: 70rem)').addEventListener('change', () => {
    for (const menu of menus) menu.open = false;
  });
</script>
<style>
.site-header{position:sticky;top:0;z-index:20;border-bottom:1px solid var(--border);background:color-mix(in srgb,var(--bg) 92%,transparent);backdrop-filter:blur(14px)}.nav-wrap{min-height:4.5rem;display:flex;align-items:center;gap:1rem}.brand{display:block;width:clamp(8.75rem,14vw,11rem);line-height:0}.brand picture,.brand img{display:block;width:100%;height:auto}.desktop-nav{margin-left:auto;display:flex;gap:1.15rem;align-items:center}.desktop-nav a{font-size:.85rem;font-weight:650;text-decoration:none;color:var(--muted)}.desktop-nav a:hover{color:var(--text)}.member-cta{display:inline-flex;align-items:center;gap:.45rem;white-space:nowrap;text-decoration:none;font-size:.83rem;font-weight:900;padding:.66rem 1rem;border-radius:999px;background:var(--text);color:var(--bg);transition:transform .2s ease,box-shadow .2s ease}.member-cta:hover{transform:translateY(-2px);box-shadow:var(--shadow-soft)}.member-cta span{font-size:1rem}.mobile-menu{display:none;position:relative}.mobile-menu > summary{width:2.75rem;height:2.75rem;display:grid;place-content:center;gap:.35rem;border:1px solid var(--border);border-radius:50%;cursor:pointer;list-style:none}.mobile-menu > summary::-webkit-details-marker{display:none}.mobile-menu > summary span{width:1rem;height:2px;background:var(--text)}.mobile-menu nav{max-height:calc(100dvh - 6rem);overflow-y:auto;overscroll-behavior:contain;position:absolute;right:0;top:3.25rem;width:min(19rem,calc(100vw - 1.25rem));padding:.5rem;border:1px solid var(--border);border-radius:var(--radius-md);background:var(--surface-strong);box-shadow:var(--shadow-soft)}.mobile-menu nav a{display:flex;justify-content:space-between;padding:.9rem 1rem;border-radius:.65rem;text-decoration:none;font-weight:750}.mobile-menu nav a:hover{background:var(--surface)}.mobile-menu i{font-style:normal;color:var(--accent)}
:global(:root[data-theme='dark']) .brand picture source{display:none}:global(:root[data-theme='dark']) .brand img{content:url('/brand/logo/big-sox-studios-logo-light.webp')}
@media(max-width:70rem){.desktop-nav,.sign-in-menu{display:none}.brand{width:clamp(6.75rem,22vw,8.5rem)}.nav-wrap{gap:.5rem}.member-cta{margin-left:auto;padding:.61rem .8rem;font-size:.78rem}.nav-wrap>:global(.theme-toggle){margin-left:0}.mobile-menu{display:block}}
.sign-in-menu{position:relative;flex-shrink:0}.sign-in-menu > summary{display:flex;align-items:center;gap:.4rem;min-height:2.75rem;padding:.5rem .65rem;font-size:.85rem;font-weight:750;cursor:pointer;list-style:none}.sign-in-menu > summary::-webkit-details-marker{display:none}.chevron{transition:transform .15s ease}.sign-in-menu[open] .chevron{transform:rotate(180deg)}.sign-in-options{list-style:none;margin:0;padding:.4rem}.sign-in-menu > .sign-in-options{position:absolute;right:0;top:calc(100% + .5rem);width:16rem;border:1px solid var(--border);border-radius:var(--radius-md);background:var(--surface-strong);box-shadow:var(--shadow-soft)}.sign-in-options a,.sign-in-disabled{display:flex;align-items:center;justify-content:space-between;gap:.75rem;min-height:2.75rem;padding:.9rem .75rem;border-radius:.65rem;font-size:.85rem;font-weight:750;text-decoration:none}.sign-in-options a:hover{background:var(--surface)}.sign-in-disabled{color:var(--text)}.sign-in-disabled small{font-size:.7rem;white-space:nowrap;font-weight:650;border:1px solid currentColor;border-radius:999px;padding:.2rem .4rem}.mobile-sign-in{border-top:1px solid var(--border);margin-top:.5rem;padding-top:.5rem}.mobile-sign-in h2{font-family:var(--font-body);font-size:.8rem;line-height:1.5;margin:.4rem 1rem;color:var(--muted)}.mobile-sign-in .sign-in-options{padding:0}.mobile-sign-in .sign-in-options a{font-size:.85rem;padding:.9rem 1rem}.mobile-sign-in .sign-in-disabled{padding:.9rem 1rem}
@media(max-width:22rem){.nav-wrap{gap:.25rem}.member-cta{padding-inline:.6rem}.nav-wrap>:global(.theme-toggle){padding-inline:.6rem}}
@media(forced-colors:active){.member-cta{border:1px solid ButtonText}.sign-in-disabled{color:GrayText}.mobile-menu > summary span{background:ButtonText}}
</style>